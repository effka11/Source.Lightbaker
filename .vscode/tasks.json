{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lightbaker: Build & open",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "Get-Process lightbaker -ErrorAction SilentlyContinue | Stop-Process -Force; cargo run --release -p window --bin lightbaker"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$rustc"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
